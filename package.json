{
  "name": "kutty-couture-inventory",
  "productName": "Kutty Couture",
  "version": "1.0.0",
  "description": "Inventory management application for Kutty Couture",
  "author": "Kutty Couture",
  "private": true,
  "homepage": "./",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-data-grid": "^9.0.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "react-scripts": "5.0.1",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "clean": "rimraf dist",
    "electron": "node ./node_modules/electron/cli.js ./electron.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "desktop": "npm run build && npm run electron",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "pack:win": "npm run build && electron-builder --win portable --publish never"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.kuttycouture.inventory",
    "productName": "Kutty Couture",
    "asar": false,
    "extraMetadata": {
      "main": "electron.js"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "electron.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/appIcon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "immohanrajmuthu1502",
      "repo": "inventory-win-app"
    }
  },
  "main": "electron.js"
}
